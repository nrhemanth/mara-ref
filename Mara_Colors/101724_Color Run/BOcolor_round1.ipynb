   "source": [
    "# CV RGB Data Extraction"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 49,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x1000 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Load the image\n",
    "image = cv2.imread('IMG_2730.jpg', cv2.IMREAD_GRAYSCALE)\n",
    "image = cv2.bilateralFilter(image,9,75,75)\n",
    "image_rgb = cv2.imread('IMG_2730.jpg')\n",
    "\n",
    "# Apply thresholding to isolate wells\n",
    "ret, thresh = cv2.threshold(image, 127, 255, cv2.THRESH_BINARY_INV)\n",
    "\n",
    "# Find contours of the wells\n",
    "contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n",
    "\n",
    "# Helper function to get the centroid y-coordinate of a contour\n",
    "def get_contour_y(contour):\n",
    "    M = cv2.moments(contour)\n",
    "    if M[\"m00\"] != 0:\n",
    "        return int(M[\"m01\"] / M[\"m00\"])  # Y-coordinate of the centroid\n",
    "    return 0\n",
    "\n",
    "# Sort contours by their y-coordinate\n",
    "contours_ordered = sorted(contours, key=get_contour_y)\n",
    "\n",
    "contour_plot = []\n",
    "rgb_values = []\n",
    "\n",
    "# Iterate through each detected contour\n",
    "for contour in contours_ordered:\n",
    "    if cv2.contourArea(contour) < 10000:\n",
    "        continue  # Skip small contours\n",
    "\n",
    "    contour_plot.append(contour)\n",
    "\n",
    "    # Create a mask for the current well\n",
    "    mask = np.zeros(image_rgb.shape[:2], dtype=\"uint8\")\n",
    "    cv2.drawContours(mask, [contour], -1, 255, -1)\n",
    "\n",
    "    # Extract the ROI (well) using the mask\n",
    "    well_pixels = cv2.bitwise_and(image_rgb, image_rgb, mask=mask)\n",
    "    \n",
    "    # Calculate the average BGR values\n",
    "    mean_val = cv2.mean(image_rgb, mask=mask)[:3]\n",
    "    rgb_values.append(mean_val[::-1]) # Reverse BGR output to RGB\n",
    "\n",
    "output_image = image_rgb.copy()\n",
    "cv2.drawContours(output_image, contour_plot, -1, (0, 0, 255), 2)\n",
    "output_image_rgb = cv2.cvtColor(output_image, cv2.COLOR_BGR2RGB)  # Convert to RGB for matplotlib\n",
    "\n",
    "# Double check contours\n",
    "plt.figure(figsize=(12,10))\n",
    "plt.imshow(output_image_rgb)\n",
    "plt.axis('off')  # Hide axis\n",
    "plt.title('CV2 RGB Data Extraction With Contours')\n",
    "plt.show()"
   ]
  },
