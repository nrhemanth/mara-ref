    "def load_image(image_path):\n",
    "    # Load and convert the image to RGB if not already in that mode\n",
    "    image = Image.open(image_path).convert(\"RGB\")\n",
    "    return image\n",
    "def display_image_with_pixel_value(image_path, x, y):\n",
    "    # Load the image\n",
    "    image = load_image(image_path)\n",
    "    # Convert image to array for display purposes\n",
    "    image_array = np.array(image)\n",
    "    # Get the RGB value at the selected coordinates\n",
    "    rgb_value = image.getpixel((x, y))\n",
    "    # Create a copy of the image to draw the red dot\n",
    "    draw = ImageDraw.Draw(image)\n",
    "    dot_radius = 5\n",
    "    draw.ellipse((x - dot_radius, y - dot_radius, x + dot_radius, y + dot_radius), fill='red', outline='red')\n",
    "    # Display the image with the red dot\n",
    "    plt.figure(figsize=(6,6))  # Optional: Set figure size\n",
    "    plt.imshow(image)\n",
    "    plt.axis('on')\n",
    "    plt.title(f'RGB value at ({x}, {y}): {rgb_value}')\n",
    "# Load the image and get dimensions\n",
    "image_path = 'IMG_2730.jpg'\n",
    "image = load_image(image_path)\n",
    "width, height = image.size\n",
    "# Create interactive sliders for x and y coordinates\n",
    "interact(display_image_with_pixel_value,\n",
    "         image_path=fixed(image_path),\n",
    "         x=IntSlider(min=0, max=width-1, step=1, value=width//2),\n",
    "         y=IntSlider(min=0, max=height-1, step=1, value=height//2))"
   ]
