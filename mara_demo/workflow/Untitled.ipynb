    "# ==================================================\n",
    "# CLIENT CODE - Run this on localhost (localhost:8888)\n",
    "# ==================================================\n",
    "\n",
    "import asyncio\n",
    "import websockets\n",
    "import json\n",
    "\n",
    "class OpentronsBridge:\n",
    "    def __init__(self, robot_ip=\"196.254.194.251\", port=9000):\n",
    "        self.robot_ip = robot_ip\n",
    "        self.port = port\n",
    "        self.websocket = None\n",
    "    \n",
    "    async def connect(self):\n",
    "        \"\"\"Connect to the Opentrons server\"\"\"\n",
    "        uri = f\"ws://{self.robot_ip}:{self.port}\"\n",
    "        try:\n",
    "            self.websocket = await websockets.connect(uri)\n",
    "            print(f\"Connected to Opentrons at {uri}\")\n",
    "            return True\n",
    "        except Exception as e:\n",
    "            print(f\"Connection failed: {e}\")\n",
    "            return False\n",
    "    \n",
    "    async def disconnect(self):\n",
    "        \"\"\"Close the connection to Opentrons\"\"\"\n",
    "        if self.websocket:\n",
    "            await self.websocket.close()\n",
    "            print(\"Disconnected from Opentrons\")\n",
    "    \n",
    "    async def send_message(self, message):\n",
    "        \"\"\"Send a message to Opentrons and get the response\"\"\"\n",
    "        if not self.websocket:\n",
    "            print(\"Not connected to Opentrons\")\n",
    "            return None\n",
    "        \n",
    "        try:\n",
    "            # Send the message\n",
    "            await self.websocket.send(message)\n",
    "            print(f\"Sent to Opentrons: {message}\")\n",
    "            \n",
    "            # Wait for a response\n",
    "            response = await self.websocket.recv()\n",
    "            print(f\"Received from Opentrons: {response}\")\n",
    "            return response\n",
    "        except Exception as e:\n",
    "            print(f\"Communication error: {e}\")\n",
    "            return None\n",
    "\n",
    "# Test function to run in a cell\n",
    "async def test_opentrons_connection():\n",
    "    # Connect to Opentrons\n",
    "    bridge = OpentronsBridge()\n",
    "    connected = await bridge.connect()\n",
    "    \n",
    "    if connected:\n",
    "        try:\n",
    "            # Test message 1\n",
    "            await bridge.send_message(\"Hello from localhost!\")\n",
    "            \n",
    "            # Test message 2\n",
    "            await bridge.send_message(\"This is a test connection\")\n",
    "            \n",
    "            # Test JSON\n",
    "            data = {\n",
    "                \"command\": \"status\",\n",
    "                \"parameters\": {\"check\": \"temperature\"}\n",
    "            }\n",
    "            await bridge.send_message(json.dumps(data))\n",
    "            \n",
    "        finally:\n",
    "            # Close the connection\n",
    "            await bridge.disconnect()\n",
    "    else:\n",
    "        print(\"Could not establish connection\")\n",
    "\n",
    "# Run the test in a cell on localhost\n",
    "def run_localhost_client():\n",
    "    try:\n",
    "        loop = asyncio.get_event_loop()\n",
    "    except RuntimeError:\n",
    "        loop = asyncio.new_event_loop()\n",
    "        asyncio.set_event_loop(loop)\n",
    "    \n",
    "    loop.run_until_complete(test_opentrons_connection())\n",
    "\n",
    "# Execute in localhost notebook:\n",
    "# run_localhost_client()\n",
    "\n",
    "\n",
    "\"\"\"\n",
    "INSTRUCTIONS:\n",
    "\n",
    "1. On your Opentrons notebook (196.254.194.251:48888):\n",
    "   - Install websockets if needed: !pip install websockets\n",
    "   - Run the SERVER CODE section in a cell\n",
    "   - Execute: server_task = run_opentrons_server()\n",
    "   - The server will start on port 9000 (you can change this if needed)\n",
    "\n",
    "2. On your localhost notebook (localhost:8888):\n",
    "   - Install websockets if needed: !pip install websockets\n",
    "   - Run the CLIENT CODE section in a cell\n",
    "   - Execute: run_localhost_client()\n",
    "   - This will connect to Opentrons and exchange some test messages\n",
    "\n",
    "3. For actual use:\n",
    "   - Create your own methods in the OpentronsBridge class for specific functionality\n",
    "   - You can send commands, data, or code to execute between the two notebooks\n",
