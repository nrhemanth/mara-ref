    "import serial\n",
    "\n",
    "# Change 'COM3' to your correct serial port (Windows) or '/dev/ttyUSBx' on Linux\n",
    "SERIAL_PORT = \"/dev/ttyACM0\"  # Use the port from Device Manager or `/dev/ttyUSB0`\n",
    "BAUD_RATE = 115200\n",
    "\n",
    "ser = serial.Serial(SERIAL_PORT, BAUD_RATE, timeout=1)\n",
    "\n",
    "# Example: Send a command\n",
    "def send_command(command):\n",
    "    \"\"\"Send a command to Opentrons via Serial.\"\"\"\n",
    "    ser.write(f\"{command}\\n\".encode('utf-8'))  # Send command\n",
    "    response = ser.readline().decode('utf-8').strip()  # Read response\n",
    "    print(\"Response from Opentrons:\", response)\n",
    "\n",
    "# Test Commands\n",
    "send_command(\"PING\")  # Opentrons should respond with \"PONG\"\n",
    "send_command(\"DISPENSE:200\")  # Opentrons will print \"Dispensing 200μL\""
