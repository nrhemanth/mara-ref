   "source": [
    "\"\"\"\n",
    "Interactive Color Matching using the exact Bayesian Optimization implementation\n",
    "- Allows user to choose a target color\n",
    "- Uses the exact same BO implementation from the original code\n",
    "- Prints CMYK values after each iteration\n",
    "\"\"\"\n",
    "\n",
    "from pyDOE import lhs\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.spatial import distance\n",
    "from sklearn.gaussian_process import GaussianProcessRegressor\n",
    "from sklearn.gaussian_process.kernels import RBF, ConstantKernel as C\n",
    "from scipy.optimize import minimize\n",
    "from scipy.stats import norm\n",
    "import random\n",
    "\n",
    "# Color conversion functions\n",
    "def RGB_to_CMYK(RGB_sample):\n",
    "    Red = RGB_sample[0]\n",
    "    Green = RGB_sample[1]\n",
    "    Blue = RGB_sample[2]\n",
    "\n",
    "    Black = min(1-Red, 1-Green, 1-Blue)\n",
    "    \n",
    "    # Handle division by zero\n",
    "    if Black == 1:\n",
    "        return np.array([0, 0, 0, 1])\n",
    "        \n",
    "    Cyan = (1-Red-Black)/(1-Black)\n",
    "    Magenta = (1-Green-Black)/(1-Black)\n",
    "    Yellow = (1-Blue-Black)/(1-Black) \n",
    "\n",
    "    return np.array([Cyan, Magenta, Yellow, Black])\n",
    "\n",
    "def CMYK_to_RGB(cmyk):\n",
    "    \"\"\"Convert CMYK in [0,1] to RGB in [0,1]\"\"\"\n",
    "    c, m, y, k = cmyk\n",
    "    r = (1 - c) * (1 - k)\n",
    "    g = (1 - m) * (1 - k)\n",
    "    b = (1 - y) * (1 - k)\n",
    "    return np.array([r, g, b])\n",
    "\n",
    "def get_target_color():\n",
    "    \"\"\"Let user choose a target color\"\"\"\n",
    "    print(\"\\n=== Target Color Selection ===\")\n",
    "    print(\"Enter RGB values (0-255) for your target color\")\n",
    "    \n",
    "    # Option to use a predefined color\n",
    "    preset_option = input(\"Use a preset color? (y/n): \").strip().lower()\n",
    "    if preset_option == 'y':\n",
    "        presets = {\n",
    "            '1': [255, 0, 0],    # Red\n",
    "            '2': [0, 255, 0],    # Green\n",
    "            '3': [0, 0, 255],    # Blue\n",
    "            '4': [255, 255, 0],  # Yellow\n",
    "            '5': [0, 255, 255],  # Cyan\n",
    "            '6': [255, 0, 255],  # Magenta\n",
    "            '7': [128, 0, 128],  # Purple\n",
    "            '8': [165, 42, 42],  # Brown\n",
    "            '9': [224, 1y63, 46],  # orange\n",
    "            '10': [75, 46, 131], # Deep Purple (from your example)\n",
    "        }\n",
    "        \n",
    "        print(\"Available preset colors:\")\n",
    "        for key, color in presets.items():\n",
    "            print(f\"{key}: RGB{tuple(color)}\")\n",
    "            \n",
    "        choice = input(\"Enter your choice (1-10): \").strip()\n",
    "        if choice in presets:\n",
    "            target_rgb = presets[choice]\n",
    "        else:\n",
    "            print(\"Invalid choice, using default color (75, 46, 131)\")\n",
    "            target_rgb = [75, 46, 131]\n",
    "    else:\n",
    "        # Manual RGB entry\n",
    "        try:\n",
    "            r = int(input(\"Red (0-255): \").strip())\n",
    "            g = int(input(\"Green (0-255): \").strip())\n",
    "            b = int(input(\"Blue (0-255): \").strip())\n",
    "            target_rgb = [max(0, min(255, r)), max(0, min(255, g)), max(0, min(255, b))]\n",
    "        except ValueError:\n",
    "            print(\"Invalid input, using default color (75, 46, 131)\")\n",
    "            target_rgb = [75, 46, 131]\n",
    "    \n",
    "    # Normalize to [0,1] range\n",
    "    max_RGB = 255\n",
    "    target_rgb_norm = np.array(target_rgb) / max_RGB\n",
    "    target_cmyk = RGB_to_CMYK(target_rgb_norm)\n",
    "    \n",
    "    print(f\"\\nTarget color: RGB{target_rgb} → CMYK[{', '.join([f'{v:.3f}' for v in target_cmyk])}]\")\n",
    "    \n",
    "    # Display the target color\n",
    "    plt.figure(figsize=(3, 3))\n",
    "    plt.imshow([[target_rgb_norm]], extent=[0, 1, 0, 1])\n",
    "    plt.axis(\"off\")\n",
    "    plt.title(\"Target Color\")\n",
    "    plt.show()\n",
    "    \n",
    "    return target_rgb, target_rgb_norm, target_cmyk\n",
    "\n",
    "def get_initial_sample():\n",
    "    \"\"\"Get initial CMYK sample\"\"\"\n",
    "    print(\"\\n=== Initial Sample Selection ===\")\n",
    "    print(\"Enter initial CMYK values (0-270) or use random\")\n",
    "    \n",
    "    use_random = input(\"Use random initial sample? (y/n): \").strip().lower()\n",
    "    \n",
    "    max_well_volume = 270\n",
    "    \n",
    "    if use_random == 'n':\n",
    "        try:\n",
    "            c = float(input(\"Cyan (0-270): \").strip())\n",
    "            m = float(input(\"Magenta (0-270): \").strip())\n",
    "            y = float(input(\"Yellow (0-270): \").strip())\n",
    "            k = float(input(\"Black (0-270): \").strip())\n",
    "            \n",
    "            # Validate input\n",
    "            c = max(0, min(270, c))\n",
    "            m = max(0, min(270, m))\n",
    "            y = max(0, min(270, y))\n",
    "            k = max(0, min(270, k))\n",
    "            \n",
    "            # Normalize to [0,1] range\n",
    "            sample_CMYK_norm = np.array([[c, m, y, k]]) / max_well_volume\n",
    "        except ValueError:\n",
    "            print(\"Invalid input, using random sample\")\n",
    "            sample_CMYK_norm = np.random.rand(1, 4)\n",
    "    else:\n",
    "        print(\"Generating random CMYK sample...\")\n",
    "        sample_CMYK_norm = np.random.rand(1, 4)\n",
    "        \n",
    "        # Scale values to make them more reasonable\n",
    "        total = np.sum(sample_CMYK_norm)\n",
    "        if total > 2.0:  # Arbitrary threshold\n",
    "            sample_CMYK_norm = sample_CMYK_norm * (2.0 / total)\n",
    "    \n",
    "    print(f\"\\nInitial CMYK sample: [{', '.join([f'{v:.3f}' for v in sample_CMYK_norm[0]])}]\")\n",
    "    initial_rgb = CMYK_to_RGB(sample_CMYK_norm[0])\n",
    "    \n",
    "    # Display the initial color\n",
    "    plt.figure(figsize=(3, 3))\n",
    "    plt.imshow([[initial_rgb]], extent=[0, 1, 0, 1])\n",
    "    plt.axis(\"off\")\n",
    "    plt.title(\"Initial Sample Color\")\n",
    "    plt.show()\n",
    "    \n",
    "    return sample_CMYK_norm\n",
    "\n",
    "def display_cmyk_volumes(cmyk, max_volume=270, title=\"CMYK Volumes\"):\n",
    "    \"\"\"Display CMYK volumes in microliters\"\"\"\n",
    "    volumes = [round(val * max_volume, 2) for val in cmyk]\n",
    "    \n",
    "    print(f\"\\n=== {title} ===\")\n",
    "    print(f\"Cyan: {volumes[0]}µL\")\n",
    "    print(f\"Magenta: {volumes[1]}µL\")\n",
    "    print(f\"Yellow: {volumes[2]}µL\")\n",
    "    print(f\"Black: {volumes[3]}µL\")\n",
    "    print(f\"Total: {sum(volumes):.2f}µL\")\n",
    "    \n",
    "    return volumes\n",
    "\n",
    "def compare_colors(cmyk1, cmyk2, labels=[\"Color 1\", \"Color 2\"]):\n",
    "    \"\"\"Compare two CMYK colors side by side\"\"\"\n",
    "    rgb1 = CMYK_to_RGB(cmyk1)\n",
    "    rgb2 = CMYK_to_RGB(cmyk2)\n",
    "    \n",
    "    plt.figure(figsize=(6, 3))\n",
    "    plt.subplot(1, 2, 1)\n",
    "    plt.imshow([[rgb1]], extent=[0, 1, 0, 1])\n",
    "    plt.axis(\"off\")\n",
    "    plt.title(labels[0])\n",
    "    \n",
    "    plt.subplot(1, 2, 2)\n",
    "    plt.imshow([[rgb2]], extent=[0, 1, 0, 1])\n",
    "    plt.axis(\"off\")\n",
    "    plt.title(labels[1])\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "def column(matrix, i):\n",
    "    \"\"\"Extract column i from matrix\"\"\"\n",
    "    return np.array([row[i] for row in matrix])\n",
    "\n",
    "def visualize_color_selection(X_samples, target_color_norm):\n",
    "    \"\"\"\n",
    "    Visualize the color combinations chosen by the algorithm over iterations.\n",
    "    Display colors in a grid with 10 colors per row.\n",
    "    \"\"\"\n",
    "    n_samples = len(X_samples)\n",
    "    colors_per_row = 5  # Limit to 5 colors per row\n",
    "    n_rows = (n_samples + colors_per_row - 1) // colors_per_row  # Calculate total rows\n",
    "\n",
    "    plt.figure(figsize=(12, n_rows * 2))\n",
    "    for idx, cmyk in enumerate(X_samples):\n",
    "        row = idx // colors_per_row\n",
    "        col = idx % colors_per_row\n",
    "        \n",
    "        # Convert CMYK to RGB for display\n",
    "        rgb = CMYK_to_RGB(cmyk)\n",
    "\n",
    "        # Each color is displayed in its own grid\n",
    "        plt.subplot(n_rows, colors_per_row, idx + 1)\n",
    "        plt.imshow([[rgb]], extent=[0, 1, 0, 1])\n",
    "        plt.axis(\"off\")\n",
    "        plt.title(f\"Iter {idx + 1}\", fontsize=10)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    # Show target color for reference\n",
    "    plt.figure(figsize=(3, 3))\n",
    "    target_rgb = CMYK_to_RGB(target_color_norm)\n",
    "    plt.imshow([[target_rgb]], extent=[0, 1, 0, 1])\n",
    "    plt.axis(\"off\")\n",
    "    plt.title(\"Target Color\", fontsize=12)\n",
    "    plt.show()\n",
    "\n",
    "def run_interactive_bo_simulation():\n",
    "    \"\"\"Run the interactive BO simulation using the exact same algorithm\"\"\"\n",
    "    # Constants\n",
    "    max_well_volume = 270\n",
    "    hyperparameter = 0.01\n",
    "    threshold = 0.025\n",
    "    max_iterations = 20\n",
    "    n_features = 4  # CMYK components\n",
    "    bounds = [(0, 1)] * n_features  # CMYK values are normalized between 0 and 1\n",
    "    \n",
    "    # Step 1: Get target color from user\n",
    "    target_rgb, target_rgb_norm, target_cmyk = get_target_color()\n",
    "    \n",
    "    # Step 2: Get initial sample\n",
    "    sample_CMYK_norm = get_initial_sample()\n",
    "    \n",
    "    # Step 3: Calculate initial distance and objective\n",
    "    initial_distance = np.linalg.norm(sample_CMYK_norm - target_cmyk)\n",
    "    print(f\"Initial distance to target: {initial_distance:.4f}\")\n",
    "    \n",
    "    # Display volumes\n",
    "    display_cmyk_volumes(sample_CMYK_norm[0], max_well_volume, \"Initial Sample Volumes\")\n",
    "    \n",
    "    # Compare with target\n",
    "    compare_colors(sample_CMYK_norm[0], target_cmyk, [\"Initial Sample\", \"Target\"])\n",
    "    \n",
    "    # Initialize BO variables exactly as in the original code\n",
    "    X = sample_CMYK_norm  # Initial mixtures (inputs)\n",
    "    y = -np.linalg.norm(X - target_cmyk, axis=1)  # Objective: minimize distance to target color\n",
    "    \n",
    "    # Gaussian Process Regression model - exactly as in original code\n",
    "    kernel = C(constant_value=1, constant_value_bounds=(1e-3, 1e3)) * RBF(length_scale=1, length_scale_bounds=(1e-3, 1e3))\n",
    "    gp = GaussianProcessRegressor(kernel=kernel, n_restarts_optimizer=10, alpha=1e-4, normalize_y=False)\n",
    "    \n",
    "    # Expected Improvement function - exactly as in original code\n",
    "    def expected_improvement(X, X_sample, y_sample, model):\n",
    "        \"\"\"Return the expected improvement.\"\"\"\n",
    "        mu, sigma = model.predict(X, return_std=True)\n",
    "        \n",
    "        optiminal_sample = np.min(y_sample)\n",
    "        \n",
    "        with np.errstate(divide=\"ignore\"):\n",
    "            imp = mu - optiminal_sample - hyperparameter\n",
    "            Z = imp / sigma\n",
    "            ei = imp * norm.cdf(Z) + sigma * norm.pdf(Z)\n",
    "            ei[sigma == 0.0] = 0.0\n",
    "        return ei.flatten()\n",
    "    \n",
    "    # Propose location function - exactly as in original code\n",
    "    def propose_location(acquisition, X_sample, y_sample, bounds, n_restarts=25):\n",
    "        dim = X_sample.shape[1]\n",
    "\n",
    "        def min_obj(x):\n",
    "            return -acquisition(x.reshape(-1, dim), X_sample, y_sample, gp)\n",
    "\n",
    "        # Starting points for optimization\n",
    "        x0_list = np.random.uniform(0, 1, size=(n_restarts, dim))\n",
    "        best_x, best_val = None, float(\"inf\")\n",
    "        for x0 in x0_list:\n",
    "            res = minimize(min_obj, x0, bounds=bounds, method=\"L-BFGS-B\")\n",
    "            if res.fun < best_val:\n",
    "                best_val = res.fun\n",
    "                best_x = res.x\n",
    "        return best_x\n",
    "    \n",
    "    # Interactive simulation\n",
    "    distances = [-y[0]]  # Track distances to target\n",
    "    X_samples = [X[0]]  # Track all CMYK samples\n",
    "    \n",
    "    # Main interactive loop\n",
    "    for i in range(max_iterations):\n",
    "        # Fit GP model - exactly as in original code\n",
    "        gp.fit(X, y)\n",
    "        \n",
    "        # Propose next sample - exactly as in original code\n",
    "        X_next = propose_location(expected_improvement, X, y, bounds)\n",
    "        \n",
    "        # Calculate objective for new sample - exactly as in original code\n",
    "        y_next = -np.linalg.norm(X_next - target_cmyk)\n",
    "        \n",
    "        # Display information for this iteration\n",
    "        print(f\"\\n=== Iteration {i+1} ===\")\n",
    "        print(f\"Suggested CMYK: [{', '.join([f'{v:.3f}' for v in X_next])}]\")\n",
    "        \n",
    "        # Display volumes\n",
    "        display_cmyk_volumes(X_next, max_well_volume, f\"Iteration {i+1} Volumes\")\n",
    "        \n",
    "        # Compare with target\n",
    "        compare_colors(X_next, target_cmyk, [f\"Iteration {i+1}\", \"Target\"])\n",
    "        \n",
    "        print(f\"Distance to target: {-y_next:.4f}\")\n",
    "        \n",
    "        # Track the distance\n",
    "        distances.append(-y_next)\n",
    "        X_samples.append(X_next)\n",
    "        \n",
    "        # Check if we've reached the threshold\n",
    "        if -y_next < threshold:\n",
    "            print(f\"\\nReached threshold! Distance {-y_next:.4f} < {threshold}\")\n",
    "            break\n",
    "        \n",
    "        # Ask if user wants to continue\n",
    "        user_input = input(\"\\nContinue to next iteration? (y/n): \").strip().lower()\n",
    "        if not user_input.startswith('y'):\n",
    "            break\n",
    "        \n",
    "        # Append the new sample to dataset - exactly as in original code\n",
    "        X = np.vstack((X, X_next))\n",
    "        y = np.append(y, y_next)\n",
    "    \n",
    "    # Display final results\n",
    "    print(\"\\n=== Final Results ===\")\n",
    "    optimal_idx = np.argmin(distances)\n",
    "    best_cmyk = X_samples[optimal_idx]\n",
    "    \n",
    "    print(f\"Total iterations: {len(distances) - 1}\")  # Subtract 1 for initial sample\n",
    "    print(f\"Best distance to target: {distances[optimal_idx]:.4f} at iteration {optimal_idx if optimal_idx > 0 else 'initial'}\")\n",
    "    print(f\"Optimal CMYK mixture: [{', '.join([f'{v:.3f}' for v in best_cmyk])}]\")\n",
    "    \n",
    "    # Display best volumes\n",
    "    display_cmyk_volumes(best_cmyk, max_well_volume, \"Optimal Sample Volumes\")\n",
    "    \n",
    "    # Compare best with target\n",
    "    compare_colors(best_cmyk, target_cmyk, [\"Best Result\", \"Target\"])\n",
    "    \n",
    "    # Plot convergence\n",
    "    plt.figure(figsize=(10, 6))\n",
    "    plt.plot(range(len(distances)), distances, marker='o', linestyle='-', color='b')\n",
    "    plt.title('Convergence of Bayesian Optimization')\n",
    "    plt.xlabel('Iteration')\n",
    "    plt.ylabel('Distance to Target Color')\n",
    "    plt.grid(True)\n",
    "    plt.show()\n",
    "    \n",
    "    # Visualize all colors\n",
    "    print(\"\\nVisualizing all color samples...\")\n",
    "    visualize_color_selection(X_samples, target_cmyk)\n",
    "    \n",
    "    return best_cmyk, target_cmyk, distances\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    print(\"=== Interactive Bayesian Optimization Color Matcher ===\")\n",
    "    print(\"This script uses the EXACT same BO implementation as your original code\")\n",
    "    print(\"It simulates the optimization process step by step, showing CMYK values at each iteration\")\n",
    "    \n",
    "    # Set random seed for reproducibility\n",
    "    np.random.seed(41)  # Same as in your original code\n",
    "    \n",
    "    run_interactive_bo_simulation()"
   ]
  }
